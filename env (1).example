# Copy this file to .env for local development.
# On Vercel, set these under Project Settings > Environment Variables instead.

SECRET_KEY=change_this_to_a_random_secret_string
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Get this from your Neon project dashboard (Connection string).
# Example: postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# Get these from your Cloudinary dashboard (cloudinary.com) — free tier is
# enough for profile pictures.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
